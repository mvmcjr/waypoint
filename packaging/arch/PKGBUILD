# Maintainer: Marcos Cordeiro
#
# Used by the `arch` job in .github/workflows/release.yml, which stamps pkgver
# from the release tag (scripts/set-version.mjs). It builds the checkout this
# file lives in, against the system WebKitGTK, and reinstalls node_modules
# without install scripts, so don't run it in a working copy: install the
# .pkg.tar.zst from a release instead.
pkgname=waypoint
pkgver=0.1.0
pkgrel=1
pkgdesc='Git GUI with a visual commit timeline'
arch=('x86_64')
url='https://github.com/mvmcjr/waypoint'
license=('MIT')
depends=('cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'libgcc' 'libsoup3' 'webkit2gtk-4.1' 'zlib'
         'hicolor-icon-theme' 'sh'
         'git'                 # remote operations run the git CLI
         'xdg-desktop-portal') # folder picker, opening links
makedepends=('cargo' 'nodejs' 'pnpm' 'cmake')
optdepends=('xdg-desktop-portal-gtk: native folder picker on non-GNOME desktops')
# !lto as Arch's Rust package guidelines recommend; !debug skips the separate
# waypoint-debug package.
options=('!lto' '!debug')

_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  # Dependency install scripts only fetch e2e browser drivers or verify
  # binaries; pnpm 11+ fails on unapproved ones instead of skipping them.
  pnpm install --frozen-lockfile --ignore-scripts
  pnpm tauri build --no-bundle
}

package() {
  cd "$_root"
  # The binary lives in /usr/lib so /usr/bin/waypoint can be a launcher that
  # detaches from the terminal; cli.rs hides the shim setting for this layout.
  install -Dm755 src-tauri/target/release/waypoint "$pkgdir/usr/lib/waypoint/waypoint"
  install -Dm755 packaging/arch/waypoint.sh "$pkgdir/usr/bin/waypoint"
  install -Dm644 packaging/arch/waypoint.desktop "$pkgdir/usr/share/applications/waypoint.desktop"
  for size in 32 64 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/waypoint.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/waypoint.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
